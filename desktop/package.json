{
  "name": "vns-studio",
  "productName": "VNS Studio",
  "version": "7.1.0",
  "description": "VNS Studio · 像素风视觉小说编辑器",
  "author": "Teasssss",
  "license": "free",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.teasssss.vnsstudio",
    "productName": "VNS Studio",
    "copyright": "© 2026 Teasssss",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.ico"
    ],
    "afterPack": "scripts/afterPack.js",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "VNS-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VNS Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
